<config>
    <!-- Assign to the cellular interface of all eNodeBs and UEs one address of type 10.x.x.x, since dynamic-created UEs will be assigned one such address -->
    <interface hosts="gnb*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="ue*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="mobileMecHost*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    
    <!-- Assign 192.168.x.x addresses to all other interfaces -->
    <interface hosts="**" address="192.168.x.x" netmask="255.255.255.0"/>
    
	<route hosts="gnb*" destination="192.168.4.2" netmask="255.255.255.255" interface="pppIf" metric="0"/>
	<route hosts="iUpf1" destination="192.168.7.2" netmask="255.255.255.255" interface="ppp0" metric="0"/>
	<route hosts="iUpf1" destination="10.0.0.2" netmask="255.255.255.255" interface="ppp0" metric="0"/>
	<route hosts="iUpf1" destination="192.168.10.2" netmask="255.255.255.255" interface="ppp0" metric="0"/>
	<route hosts="iUpf1" destination="10.0.0.3" netmask="255.255.255.255" interface="ppp0" metric="0"/>

</config>